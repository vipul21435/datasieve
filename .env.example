# Copy to .env (git-ignored) to set curator's runtime settings for this checkout.
# Every variable is optional; the values below are the defaults.
# Real environment variables take precedence over this file.

# Minimum log level: DEBUG, INFO, WARNING, ERROR or CRITICAL.
CURATOR_LOG_LEVEL=INFO

# json: one JSON object per line on stderr (for machines); text: human-readable.
CURATOR_LOG_FORMAT=json

# Root for run outputs. A pipeline spec without output.dir writes to <work dir>/<pipeline name>.
CURATOR_WORK_DIR=.curator
